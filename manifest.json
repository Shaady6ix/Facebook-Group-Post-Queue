{
  "manifest_version": 3,
  "name": "Group Post Queue",
  "version": "0.1.0",
  "description": "Kolejka publikowania przygotowanych postów w grupie Facebooka.",
  "permissions": ["storage", "tabs", "debugger", "unlimitedStorage"],
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
  "action": {
    "default_title": "Kolejka postów",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
